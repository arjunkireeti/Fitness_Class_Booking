<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Fitness Center</title>
    <link rel="stylesheet" href="/css/style.css"> <!-- Ensure the path to your CSS file is correct -->
    <style>
        body {
            background-color: black; 
            color: white; 
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }
        .about-section {
            text-align: center;
            padding: 20px;
        }

        .trainers-section, .gym-gallery-section {
            padding: 40px;
            text-align: center;
        }

        .trainer-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            justify-items: center;
            align-items: start;
        }

        .trainer-card {
            background-color: #0a0a0a;
            border-radius: 10px;
            padding: 15px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            text-align: center;
            width: 100%;
            max-width: 250px;
        }

        .trainer-card img {
            width: 100%;
            height: auto;
            border-radius: 50%;
        }

        .gym-gallery {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .gym-gallery img {
            width: 300px;
            height: 200px;
            object-fit: cover;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>
<body>

    <header>
        <nav>
            <a href="/" class="logo">Home</a> <!-- Updated link to go to the root -->
            <a href="/about">About Us</a>
            <a href="/classregistration">Class Registration</a>
            <a href="/registration">Register</a>
            <a href="/login">Login</a>
            <a href="/schedule">Schedule</a>
        </nav>
    </header>
    
    <section class="about-section">
        <h2>About Our Fitness Center</h2>
        <p><%= aboutText %></p> <!-- Ensure aboutText is passed from the server -->
    </section>

    <section class="trainers-section">
        <h2>Meet Our Trainers</h2>
        <div class="trainer-grid">
            <% if (trainers && trainers.length > 0) { %> <!-- Check if trainers array exists and has elements -->
                <% trainers.forEach(trainer => { %>
                    <div class="trainer-card">
                        <img src="<%= trainer.image %>" alt="<%= trainer.name %>">
                        <h3><%= trainer.name %></h3>
                        <p><%= trainer.specialty %></p>
                    </div>
                <% }) %>
            <% } else { %>
                <p>No trainers available at the moment.</p> <!-- Fallback message if no trainers -->
            <% } %>
        </div>
    </section>

    <section class="gym-gallery-section">
        <h2>Explore Our Gym</h2>
        <div class="gym-gallery">
            <% if (galleryImages && galleryImages.length > 0) { %> <!-- Check if galleryImages array exists and has elements -->
                <% galleryImages.forEach(image => { %>
                    <img src="<%= image.src %>" alt="<%= image.alt %>">
                <% }) %>
            <% } else { %>
                <p>No images available in the gallery.</p> <!-- Fallback message if no images -->
            <% } %>
        </div>
    </section>

    <script src="/js/script.js"></script> <!-- Ensure the path to your JS file is correct -->
</body>
</html>