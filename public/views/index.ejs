<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Fitness Center</title>
    <link rel="stylesheet" href="/css/style.css"> <!-- Ensure to include the leading slash -->
</head>
<body style="background: url('<%= backgroundImage %>') no-repeat center center fixed; background-size: cover;">

    <header>
        <nav>
            <a href="/" class="logo">Fitness Center</a> <!-- Change to root route -->
            <ul>
                <li><button onclick="location.href='/about'" class="button">About Us</button></li> <!-- Update link to route -->
                <li><button onclick="location.href='/schedule'" class="button">Class Schedule</button></li> <!-- Update link to route -->
                <li><button onclick="location.href='/classregistration'" class="button">Register for Class</button></li> <!-- Update link to route -->
                <li><button onclick="location.href='/registration'" class="button">Register</button></li> <!-- Update link to route -->
                <li><button onclick="location.href='/login'" class="button">Login</button></li> <!-- Update link to route -->
            </ul>
        </nav>
    </header>

    <section class="hero">
        <div class="hero-content">
            <h1>Welcome to the Fitness Center</h1>
            <p>Your fitness journey begins here. Book a class today and get fit!</p>
            <a href="/schedule" class="cta-button">Explore Classes</a> <!-- Update link to route -->
        </div>
    </section>

    <script src="/js/script.js"></script> <!-- Ensure to include the leading slash -->
</body>
</html>
